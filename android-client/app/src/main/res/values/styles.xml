<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_violet</item>
        <item name="colorOnPrimary">@color/text_white</item>
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorOnSecondary">@color/text_white</item>
        <item name="android:colorBackground">@color/background_navy</item>
        <item name="colorSurface">@color/card_dark_blue_purple</item>
        <item name="colorOnSurface">@color/text_light_gray</item>
        <item name="colorError">@color/error_red</item>
        <item name="android:statusBarColor">@color/background_navy</item>
        <item name="android:navigationBarColor">@color/background_navy</item>
        <item name="android:windowBackground">@color/background_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialCardViewStyle">@style/Widget.ContinuityStudio.Card</item>
    </style>

    <style name="Widget.ContinuityStudio.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card_dark_blue_purple</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
</resources>
