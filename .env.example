# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOCAL_MODE=false
# Generate: openssl rand -base64 32
ENCRYPTION_KEY_BASE64=

# Clerk (not required when LOCAL_MODE=true)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# PostgreSQL
DATABASE_URL=

# Generic S3-compatible storage.
# Set these for local MinIO or another S3-compatible provider.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Cloudflare R2 fallback when S3_ENDPOINT is not set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Inngest
# For free local mode: http://127.0.0.1:8288
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Google Gemini
# Optional for AI-assisted script breakdown. Flow image generation does not use it.
GEMINI_API_KEY=
