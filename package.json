{
  "name": "continuity-studio",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @continuity/db generate",
    "db:push": "pnpm --filter @continuity/db db:push",
    "db:migrate": "pnpm --filter @continuity/db db:migrate",
    "flow:bridge": "node scripts/flow-bridge.mjs",
    "flow:install": "pnpm exec playwright install chromium"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "playwright": "1.63.0"
  }
}
